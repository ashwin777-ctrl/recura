# ---- Database (SQLite, zero-setup) ----
DATABASE_URL="file:./dev.db"

# ---- Recovery simulation ----
# Deterministic seed so batch metrics are 100% reproducible across runs.
RECURA_SEED="42"

# ---- Razorpay ----
# "simulation" (default) runs the built-in deterministic gateway — no keys needed.
# "live" routes entity operations through Razorpay TEST mode using the keys below.
RAZORPAY_MODE="simulation"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Used to verify incoming webhook signatures in live mode.
RAZORPAY_WEBHOOK_SECRET=""

# ---- VS Code MCP Server Authentication (Optional / As needed) ----
# GitHub MCP Server: Personal Access Token (classic or fine-grained repo scope)
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Supabase MCP Server: Access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# Vercel MCP Server: Access token from https://vercel.com/account/tokens
VERCEL_API_TOKEN=""
