{
  "name": "recura",
  "version": "1.0.0",
  "private": true,
  "description": "Recura — AI Revenue Recovery agent for Razorpay: recovers failed subscription payments with a guardrailed decision agent, full audit trail, and measured recovery metrics.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-generate.js && next build",
    "postinstall": "node scripts/db-generate.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/db-generate.js",
    "db:generate:sqlite": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:generate:pg": "prisma generate --schema=prisma/schema.prisma",
    "db:push:sqlite": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:push:pg": "prisma db push --schema=prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "setup": "prisma generate --schema=prisma/schema.sqlite.prisma && prisma db push --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "setup:pg": "prisma generate --schema=prisma/schema.prisma && prisma db push --schema=prisma/schema.prisma && tsx prisma/seed.ts",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "razorpay:test": "tsx scripts/razorpay-test-batch.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "15.2.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
